# Active provider: openrouter | openai | deepseek
CODELENS_PROVIDER=openrouter

# API keys — set the one matching your provider.
# Keys saved via the settings window (Ctrl/Cmd+P) go to the OS keychain instead of this file.
OPENROUTER_API_KEY=sk-your-openrouter-api-key-here
# OPENAI_API_KEY=sk-your-openai-api-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Optional OpenRouter ranking/tracking metadata
OPENROUTER_SITE_URL=https://codelens.app
OPENROUTER_SITE_NAME=CodeLens

# Optional logging
LOG_LEVEL=info
