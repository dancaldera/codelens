{
  "name": "codelens",
  "version": "1.0.0",
  "description": "AI-powered code analysis from screenshots - CodeLens visual code analyzer",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "typescript-check": "tsc --noEmit",
    "dev": "electron-vite dev",
    "watch": "electron-vite build --watch",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "pnpm run build && electron-builder build --mac -c.mac.identity=null",
    "package-mac-signed": "pnpm run build && electron-builder build --mac",
    "package-win": "pnpm run build && electron-builder build --win",
    "package-linux": "pnpm run build && electron-builder build --linux",
    "package-all": "pnpm run build && electron-builder build -mwl",
    "setup": "node node_modules/electron/install.js && pnpm rebuild esbuild && husky",
    "dev:mac": "node scripts/dev-mac.mjs",
    "dev:mac:setup": "node scripts/dev-mac.mjs --setup"
  },
  "author": "Daniel Caldera",
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "dompurify": "^3.4.17",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "marked": "^18.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.ts": "biome check --write"
  },
  "build": {
    "appId": "com.dancaldera.codelens",
    "productName": "CodeLens",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/"
    },
    "asar": true,
    "compression": "maximum",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CodeLens records short voice notes to add context to screenshot analysis."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
